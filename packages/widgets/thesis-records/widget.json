{
  "id": "thesis-records",
  "title": {
    "zh": "毕业论文",
    "en": "Thesis"
  },
  "description": {
    "zh": "整理毕业论文：章节与状态、研究成果及其稿件或研究记录来源、待补实验、可配置的学位节点、关联行动项与论文材料。成果只写下来源记录，来源不在时显示「来源缺失」；节点名称、日期与状态都由用户维护，不预设学校规则，也不判断毕业资格。",
    "en": "Organises a thesis: chapters and their status, results with their manuscript or research-note sources, experiments to run, configurable degree milestones, linked actions and thesis materials. A result only stores its source record and shows as missing when the source is gone; you maintain milestone names, dates and status, with no school rules assumed and no graduation eligibility judged."
  },
  "author": "dsh-scholar-board",
  "version": "0.1.0",
  "sizes": [
    "m",
    "l"
  ],
  "source": "widget-board:records",
  "capabilities": [
    "widget-board:records.read",
    "widget-board:records.write",
    "widget-board:records.draft"
  ],
  "defaultBox": {
    "w": 2,
    "h": 30
  },
  "minBox": {
    "w": 1,
    "h": 16
  },
  "scripts": [
    "thesis-model.js",
    "copy.js",
    "view.js",
    "rows.js",
    "editor.js"
  ],
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 80
      },
      "kicker": {
        "type": "string",
        "maxLength": 40
      }
    }
  },
  "data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "records": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object"
        }
      },
      "quota": {
        "type": "object"
      },
      "total": {
        "type": "number"
      },
      "truncated": {
        "type": "boolean"
      }
    }
  },
  "text": {
