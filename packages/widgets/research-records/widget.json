        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object"
        }
      },
      "quota": {
        "type": "object"
      },
      "total": {
        "type": "number"
      },
      "truncated": {
        "type": "boolean"
      }
    }
  },
