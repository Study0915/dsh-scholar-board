{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "@dsh-scholar-board/contracts": ["./packages/contracts/src/index.ts"],
      "@dsh-scholar-board/contracts/*": ["./packages/contracts/src/*"],
      "@dsh-scholar-board/model": ["./packages/model/src/index.ts"],
      "@dsh-scholar-board/model/*": ["./packages/model/src/*"]
    }
  },
  "include": ["packages/client/src", "packages/contracts/src", "packages/model/src", "packages/runtime/src"]
}
